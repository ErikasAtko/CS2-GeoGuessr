<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>CS2_GEO.Tests</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- xUnit v3 test projects are executables -->
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\CS2-GEO\CS2-GEO.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The API gets its EF Core version through Microsoft.EntityFrameworkCore.Design, which is
             PrivateAssets="all" and so doesn't flow here; without this the tests would load the older
             EF Core the Npgsql provider asks for at minimum. Floats like the API's own references. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.*" />
        <!-- WebApplicationFactory: runs the real Program.cs in memory for the integration tests -->
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
        <!-- Connects to MultiplayerHub the same way the frontend does -->
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
        <!-- Collects line coverage while the tests run (dotnet test with the coverage option) -->
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
        <!-- Generates stubs from interfaces -->
        <PackageReference Include="NSubstitute" Version="6.2.0" />
        <!-- A throwaway PostgreSQL in Docker when no team database server is configured (e.g. in CI) -->
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.17.0" />
        <PackageReference Include="xunit.v3" Version="4.0.3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
